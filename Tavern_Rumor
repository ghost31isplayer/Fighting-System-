# =====================================================
# DRINKING & PERCEPTION
# =====================================================

def try_drink(drunkenness):
    if drunkenness.is_drunk():
        print("\nThe barkeep folds his arms.")
        print("‘That’s enough for you. Come back tomorrow.’")
        return False
    drunkenness.drink()
    return True


def look_around(drunkenness):
    print("\nYou scan the tavern...")

    if drunkenness.is_drunk():
        print("The walls sway. Faces melt together. Nothing makes sense.")
        return

    if drunkenness.drinks == 0:
        print("Mercenaries brood in corners. A hooded figure watches you.")
    else:
        print("Everything feels warmer. Words blur into noise.")


# =====================================================
# RUMOR INTERACTION (LOCKED BEHIND MENU)
# =====================================================

def ask_rumor(wallet, drunkenness):
    while True:
        rumor_menu()
        choice = input("\nChoose a rumor: ")

        if choice == "0":
            return

        if not choice.isdigit() or int(choice) not in RUMORS:
            print("\n‘I don’t know anything about that.’")
            continue

        if drunkenness.is_drunk():
            print("\nYou’re too drunk to get anything useful.")
            return

        print(f"\n‘Rumors cost a drink. {DRINK_COST} copper.’")
        print(f"You have: {wallet.display()}")

        if input("Buy a drink? (y/n): ").lower() != "y":
            return

        if not wallet.spend_copper(DRINK_COST):
            print("\n‘You’re short on coin.’")
            return

        if not try_drink(drunkenness):
            return

        print("\nThe barkeep leans in.")
        print(RUMORS[int(choice)])
        print(f"\nRemaining coin: {wallet.display()}")


# =====================================================
# GAME OF WIT
# =====================================================

def game_of_wit(drunkenness):
    if drunkenness.is_drunk():
        print("\n‘Come back when you can see straight.’")
        return

    riddle = random.choice(RIDDLES)

    print("\n--- Game of Wit ---")
    print(riddle["question"])

    for i, c in enumerate(riddle["choices"], 1):
        print(f"{i}. {c}")

    answer = input("\nYour answer: ")

    if answer.isdigit() and int(answer) == riddle["correct"]:
        print("\nThe barkeep laughs. ‘On the house.’")
        try_drink(drunkenness)
    else:
        print("\n‘Wrong. No drink.’")


# =====================================================
# DICE OF DEBTS
# =====================================================

DICE_WIN_THRESHOLD = 16
DICE_COUNT = 4
HOUSE_MAX_RAISES = 4

DICE_FLAVOR_TEXT = [
    "A man storms past clutching an empty purse.",
    "A knight laughs as coins jingle at his belt.",
    "A nervous youth stares at the dice.",
    "A rougish half-man with a clean beard and a strange sheep at his side strolls past, you catch a smirk on their face.",
    "A strange muscular man with a boar mask pushes you to the side, laughing triumphantly.",
    "A small child with a empty purse runs past you, tears splashing on the old wooden floor"
]

HOUSE_BANTER = [
    "‘Care to test your fortune?’",
    "‘Easy money. For one of us.’",
    "‘Dice don’t lie… usually.’",
    "Thank the Gods, we could use the money- I mean, care for a game of chance?"
]

def roll_dice_of_debts():
    rolls = [random.randint(1, 6) for _ in range(DICE_COUNT)]
    return rolls, sum(rolls)


def dice_of_debts(wallet):
    print("\n--- Dice Corner ---")
    print(random.choice(DICE_FLAVOR_TEXT))

    wager = 4
    raises = 0

    while True:
        print(random.choice(HOUSE_BANTER))
        print(f"The house wagers {wager} copper.")
        print(f"You have: {wallet.display()}")

        if not wallet.can_afford(wager):
            print("You don’t have the coin.")
            return

        if input("Match? (y/n): ").lower() != "y":
            print("You step away from the dice.")
            return

        wallet.spend_copper(wager)

        rolls, total = roll_dice_of_debts()
        print(f"Rolls: {rolls} → {total}")

        if total > DICE_WIN_THRESHOLD:
            print("You win.")
            print(random.choice(DICE_WIN_RESPONSES))
            wallet.copper += wager * 2
            wallet.normalize()
        else:
            print("You lose.")
            print(random.choice(DICE_LOSE_RESPONSES))

        print(f"Coin: {wallet.display()}")

        raises += 1
        if raises >= HOUSE_MAX_RAISES:
            print("The house cuts you off.")
            return

        wager += max(1, wager // 2)

# =====================================================
# TAVERN CONTROLLER
# =====================================================

def ask_barkeep(wallet, drunkenness):
    tavern_menu()
    choice = input("\nChoose: ")

    if choice == "0":
        print("You leave the tavern.")
        return False

    if choice == "1":
        ask_rumor(wallet, drunkenness)
    elif choice == "2":
        look_around(drunkenness)
    elif choice == "3":
        game_of_wit(drunkenness)
    elif choice == "4":
        dice_of_debts(wallet)

    return True


# =====================================================
# MAIN LOOP
# =====================================================

def run_tavern():
    wallet = Wallet(silver=2, copper=5)
    drunkenness = Drunkenness()

    print("You enter a smoke-filled tavern.")
    print(f"Your coin: {wallet.display()}")

    while True:
        print(f"\nStatus: {drunkenness.status()}")
        if not ask_barkeep(wallet, drunkenness):
            break


if __name__ == "__main__":
    run_tavern()
