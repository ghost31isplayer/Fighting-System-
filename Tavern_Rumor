import random

# =============================
# CURRENCY SYSTEM
# =============================

class Wallet:
    def __init__(self, gold=0, silver=0, copper=0):
        self.gold = gold
        self.silver = silver
        self.copper = copper
        self.normalize()

    def normalize(self):
        if self.copper >= 20:
            self.silver += self.copper // 20
            self.copper %= 20

        if self.silver >= 20:
            self.gold += self.silver // 20
            self.silver %= 20

    def total_copper(self):
        return self.copper + (self.silver * 20) + (self.gold * 400)

    def can_afford(self, copper_cost):
        return self.total_copper() >= copper_cost

    def spend_copper(self, copper_cost):
        if not self.can_afford(copper_cost):
            return False

        total = self.total_copper() - copper_cost
        self.gold = total // 400
        total %= 400
        self.silver = total // 20
        self.copper = total % 20
        return True

    def display(self):
        return f"{self.gold}g {self.silver}s {self.copper}c"


# =============================
# DRUNKENNESS SYSTEM
# =============================

DRINK_COST = 8        # copper
DRINK_LIMIT = 3       # drinks before drunk


class Drunkenness:
    def __init__(self):
        self.drinks = 0

    def drink(self):
        self.drinks += 1

    def is_drunk(self):
        return self.drinks >= DRINK_LIMIT

    def status(self):
        if self.drinks == 0:
            return "Sober"
        elif self.drinks < DRINK_LIMIT:
            return "Buzzed"
        else:
            return "Drunk"


