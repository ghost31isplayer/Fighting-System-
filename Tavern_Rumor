# =============================
# TAVERN FUNCTIONS
# =============================

def tavern_menu():
    print("\n--- Tavern ---")
    print("1. Ask about rumors")
    print("2. Look around")
    print("3. Game of wit (riddle for a free drink)")
    print("0. Leave tavern")


def rumor_menu():
    print("\n--- Rumors ---")
    print("1. What are the locals saying?")
    print("2. Heard anything about the war?")
    print("3. Any dangers as of late?")
    print("4. Any work going around?")
    print("5. Anything strange happening?")
    print("6. Any dark rumors?")
    print("0. Back")


def try_drink(drunkenness):
    if drunkenness.is_drunk():
        print("\nThe barkeep folds his arms.")
        print("‘That’s enough for you. Come back tomorrow.’")
        return False
    drunkenness.drink()
    return True


def look_around(drunkenness):
    print("\nYou take a moment to look around the tavern...")

    if drunkenness.is_drunk():
        print("\nThe room sways and stretches.")
        print("Faces blur together. Laughter echoes too loud.")
        print("You swear the walls are breathing.")
        print("Whatever was worth noticing slips away.")
        return

    if drunkenness.drinks == 0:
        print("\nThe tavern is lively but watchful.")
        print("Mercenaries nurse cheap ale in the corners.")
        print("A hooded figure sits alone near the hearth.")
        print("The barkeep polishes a glass, listening more than he speaks.")
    else:
        print("\nThe tavern feels warmer than before.")
        print("Voices are louder, smiles a little too wide.")
        print("You catch fragments of conversation, but nothing clear.")


def ask_rumor(wallet, drunkenness):
    rumor_menu()
    choice = input("\nChoose a rumor: ")

    if choice == "0":
        return

    if not choice.isdigit():
        print("\n‘Speak clearly.’")
        return

    choice = int(choice)

    if choice not in RUMORS:
        print("\n‘I don’t know anything about that.’")
        return

    if drunkenness.is_drunk():
        print("\nYou’re too drunk to get anything useful.")
        return

    print(f"\n‘Rumors cost a drink. {DRINK_COST} copper.’")
    print(f"You have: {wallet.display()}")

    buy = input("Buy a drink? (y/n): ").lower()

    if buy != "y":
        print("\n‘Then no rumor.’")
        return

    if not wallet.spend_copper(DRINK_COST):
        print("\n‘You’re short on coin.’")
        return

    if not try_drink(drunkenness):
        return

    print("\nThe barkeep leans closer.")
    print(RUMORS[choice])
    print(f"\nRemaining coin: {wallet.display()}")


def game_of_wit(drunkenness):
    if drunkenness.is_drunk():
        print("\nYou can barely focus. The barkeep waves you off.")
        return

    print("\nThe barkeep grins.")
    print("‘Game of wit. One question. Choose wisely.’")

    riddle = random.choice(RIDDLES)

    print("\nRiddle:")
    print(riddle["question"])

    for i, choice in enumerate(riddle["choices"], start=1):
        print(f"{i}. {choice}")

    answer = input("\nYour answer (1-4): ")

    if not answer.isdigit():
        print("\nThe barkeep sighs. ‘That’s not even a number.’")
        return

    if int(answer) == riddle["correct"]:
        print("\nThe barkeep laughs and pours a drink.")
        if try_drink(drunkenness):
            print("‘On the house.’")
    else:
        print("\nThe barkeep shakes his head.")
        print("‘Wrong. No drink for you.’")


def ask_barkeep(wallet, drunkenness):
    tavern_menu()
    choice = input("\nChoose an option: ")

    if choice == "0":
        print("\nYou leave the tavern.")
        return False

    if not choice.isdigit():
        print("\nThe barkeep grunts. ‘Speak clearly.’")
        return True

    choice = int(choice)

    if choice == 1:
        ask_rumor(wallet, drunkenness)
    elif choice == 2:
        look_around(drunkenness)
    elif choice == 3:
        game_of_wit(drunkenness)
    else:
        print("\nThe barkeep stares at you.")

    return True


# =============================
# MAIN LOOP
# =============================

def run_tavern():
    wallet = Wallet(gold=0, silver=2, copper=5)
    drunkenness = Drunkenness()

    print("You enter a smoke-filled tavern.")
    print(f"Your coin: {wallet.display()}")

    running = True
    while running:
        print(f"\nStatus: {drunkenness.status()}")
        running = ask_barkeep(wallet, drunkenness)


if __name__ == "__main__":
    run_tavern()
