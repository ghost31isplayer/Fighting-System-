def handle_special_encounter(encounter, wallet, drunkenness):
    print(f"\n--- Special Encounter: {encounter['name']} ---")
    print(encounter["intro"])

    # Dispatch to interaction based on type
    if encounter["type"] == "rps":
        play_rps_hafthor()

    elif encounter["type"] == "drinking":
        drink_with_kril(wallet, drunkenness)

    elif encounter["type"] == "turtle_race":
        turtle_race(wallet)  # calls separately defined function

    elif encounter["type"] == "recruit_intro":
        fee = encounter["data"]["fee"]
        choice = input(f"\nPay {fee} copper to recruit {encounter['data']['recruit']['name']}? (y/n): ").lower()
        if choice == "y":
            if wallet.can_afford(fee):
                wallet.spend_copper(fee)
                print(f"{encounter['data']['recruit']['name']} joins your party!")
            else:
                print("You don't have enough coins.")
        else:
            print("You decide not to hire him.")

    elif encounter["type"] == "bulk_recruit":
        max_recruits = encounter["data"]["max_recruits"]
        fee_per_man = encounter["data"]["fee_per_man"]
        print(f"\nYou can hire up to {max_recruits} recruits for {fee_per_man} copper each.")
        num = input("How many do you want to hire? ")
        if num.isdigit():
            num = int(num)
            total_cost = num * fee_per_man
            if num <= max_recruits and wallet.can_afford(total_cost):
                wallet.spend_copper(total_cost)
                print(f"You hired {num} {encounter['data']['quality']} recruits!")
            else:
                print("Cannot hire that many or insufficient funds.")
        else:
            print("No one is hired.")


def look_around(wallet, drunkenness):
    print("\nYou scan the tavern...")

    for encounter in TAVERN_SPECIAL_ENCOUNTERS:
        if random.random() < encounter["chance"] and encounter["condition"](drunkenness):
            handle_special_encounter(encounter, wallet, drunkenness)
            break  # Only trigger one encounter per look-around


