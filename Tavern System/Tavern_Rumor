def turtle_race(wallet):
    print("\nFour turtles are lined up for the race. Each wearing a small colored string around their head. You can bet some copper on one of them!")
    turtles = ["Red", "Blue", "Green", "Orange"]
    print("Turtles: ", ", ".join(turtles))

    bet_turtle = input("Which turtle do you bet on? (or press Enter to watch for free): ").capitalize()
    bet_amount = 0
    if bet_turtle in turtles:
        bet_input = input("How much copper do you want to bet? ")
        if bet_input.isdigit():
            bet_amount = int(bet_input)
            if not wallet.can_afford(bet_amount):
                print("You don't have enough coins. You watch for free instead.")
                bet_amount = 0
        else:
            print("Invalid amount. You watch for free instead.")

    print("\nThe race begins!")
    winner = random.choice(turtles)

    print("The turtles crawl slowly...")
    print(f"And the winner is... {winner}!")

    if bet_amount > 0:
        if bet_turtle == winner:
            winnings = bet_amount * 2
            wallet.copper += winnings
            wallet.normalize()
            print(f"You won {winnings} copper!")
        else:
            wallet.spend_copper(bet_amount)
            print(f"You lost your bet of {bet_amount} copper.")
    else:
        print("You just enjoyed the race for fun!")



