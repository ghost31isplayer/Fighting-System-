def play_rps_hafthor():
    print("\nHafthor grins wide. ‘Two outta three.’")
    print("Rock (r), Paper (p), Scissors (s). No tricks.")

    choices = {"r": "Rock", "p": "Paper", "s": "Scissors"}
    wins = 0
    losses = 0

    while wins < 2 and losses < 2:
        player = input("\nYour throw (r/p/s): ").lower()
        if player not in choices:
            print("Hafthor snorts. ‘That ain’t a throw.’")
            continue

        hafthor = random.choice(list(choices.keys()))

        print(f"You throw {choices[player]}.")
        print(f"Hafthor throws {choices[hafthor]}.")

        if player == hafthor:
            print("A draw. He laughs.")
        elif (
            (player == "r" and hafthor == "s") or
            (player == "p" and hafthor == "r") or
            (player == "s" and hafthor == "p")
        ):
            wins += 1
            print("You win the round.")
        else:
            losses += 1
            print("Hafthor wins the round.")

        print(f"Score — You: {wins} | Hafthor: {losses}")

    if wins == 2:
        print("\nHafthor roars with laughter.")
        print("‘Ha! I like you. I’ll fight with you — once.’")
        print("(Hafthor will join you for one battle.)")
        return True
    else:
        print("\nHafthor spits on the floor.")
        print("‘Come back when you’ve got hands.’")
        return False


