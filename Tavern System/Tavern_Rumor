def roll_dice_of_debts():
    rolls = [random.randint(1, 6) for _ in range(DICE_COUNT)]
    return rolls, sum(rolls)


def dice_of_debts(wallet):
    print("\n--- Dice Corner ---")
    print(random.choice(DICE_FLAVOR_TEXT))
    print(random.choice(HOUSE_INTRO))

    wager = 4
    raises = 0
    wins = 0
    losses = 0

    while True:
        print(f"\nThe wager is {wager} copper.")
        print(f"You have: {wallet.display()}")

        if not wallet.can_afford(wager):
            print("The dealer scoffs. ‘Come back with coin.’")
            return

        if input("Match? (y/n): ").lower() != "y":
            print("You push back from the table.")
            return

        wallet.spend_copper(wager)

        rolls, total = roll_dice_of_debts()
        print(f"Rolls: {rolls} → {total}")

        if total > DICE_WIN_THRESHOLD:
            wins += 1
            print("You win.")
            wallet.copper += wager * 2
            wallet.normalize()

            if wins >= 2:
                print(random.choice(CROWD_BIG_WIN))
            else:
                print(random.choice(CROWD_POSITIVE))
        else:
            losses += 1
            print("You lose.")
            print(random.choice(CROWD_NEGATIVE))

        print(f"Coin: {wallet.display()}")

        raises += 1
        if raises >= HOUSE_MAX_RAISES:
            print("\nThe dealer gathers the dice.")
            print("‘That’s enough for tonight.’")
            return

        wager += max(1, wager // 2)
        print(random.choice(HOUSE_SILENT))

