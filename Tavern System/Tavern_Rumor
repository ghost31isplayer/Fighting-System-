def ask_rumor(wallet, drunkenness):
    while True:
        rumor_menu()
        choice = input("\nChoose a rumor: ")

        if choice == "0":
            return

        if not choice.isdigit() or int(choice) not in RUMORS:
            print("\n‘I don’t know anything about that.’")
            continue

        if drunkenness.is_drunk():
            print("\nYou’re too drunk to get anything useful.")
            return

        print(f"\n‘Rumors cost a drink. {DRINK_COST} copper.’")
        print(f"You have: {wallet.display()}")

        if input("Buy a drink? (y/n): ").lower() != "y":
            return

        if not wallet.spend_copper(DRINK_COST):
            print("\n‘You’re short on coin.’")
            return

        if not try_drink(drunkenness):
            return

        print("\nThe barkeep leans in.")
        print(RUMORS[int(choice)])
        print(f"\nRemaining coin: {wallet.display()}")


